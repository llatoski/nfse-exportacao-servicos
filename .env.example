# Certificado A1 ICP-Brasil (usado para assinar a DPS e autenticar o mTLS)
CERT_PATH=/path/to/certificado-a1.pfx
CERT_PASSWORD=

# NFS-e Nacional (gov.br)
# producaorestrita = sandbox, producao = ambiente real
NFSE_AMBIENTE=producaorestrita
NFSE_BASE_URL_HOMOLOG=https://sefin.producaorestrita.nfse.gov.br
NFSE_BASE_URL_PROD=https://sefin.nfse.gov.br

# Dados fixos do prestador
PRESTADOR_CNPJ=00000000000000
PRESTADOR_RAZAO_SOCIAL=RAZAO SOCIAL DA EMPRESA LTDA
PRESTADOR_INSCRICAO_MUNICIPAL=
PRESTADOR_CEP=00000000
PRESTADOR_LOGRADOURO=R EXEMPLO
PRESTADOR_NUMERO=0
PRESTADOR_COMPLEMENTO=
PRESTADOR_BAIRRO=BAIRRO
# código IBGE do município, 7 dígitos
PRESTADOR_MUNICIPIO_IBGE=0000000
PRESTADOR_UF=XX
PRESTADOR_REGIME=SIMPLES_NACIONAL

# Serviço (confirmar o código com o contador)
SERVICO_CODIGO_LC116=1.04
SERVICO_DESCRICAO=Serviços de desenvolvimento de software

# Tomador no exterior (exportação de serviços: o ISS não incide)
TOMADOR_NOME=EXAMPLE CLIENT INC
# NIF/EIN do tomador, se houver (vazio = cNaoNIF 2, "não exigência do NIF")
TOMADOR_DOCUMENTO_EXTERIOR=
TOMADOR_PAIS=US
TOMADOR_CEP_EXT=00000
TOMADOR_CIDADE=CITY
TOMADOR_ESTADO=ST
TOMADOR_LOGRADOURO=STREET
TOMADOR_NUMERO=S/N
TOMADOR_BAIRRO=NA

# Alíquota aproximada do Simples Nacional, em %, usada só nos "Totais Aproximados" da DANFSe (Lei 12.741)
ALIQ_SIMPLES_APROX=0.0

# Saída
OUTPUT_DIR=./out
